{
  "name": "zero-state",
  "version": "2.0.0",
  "private": true,
  "description": "Add links and notes to your New Tab page. Organize them as a single list, a tree, or multiple lists/trees.",
  "type": "module",
  "scripts": {
    "build": "esbuild src/app.ts --bundle --sourcemap --outfile=dist/app.js",
    "build-min": "esbuild src/app.ts --bundle --sourcemap --outfile=dist/app.js --minify",
    "watch": "esbuild --watch src/app.ts --bundle --sourcemap --outfile=dist/app.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pkg": "node scripts/pkg.mjs",
    "test:e2e": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nmai/zero-state.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/nmai/zero-state/issues"
  },
  "homepage": "https://github.com/nmai/zero-state#readme",
  "dependencies": {
    "vanjs-core": "^1.5.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.0.307",
    "@types/node": "^26.5.0",
    "esbuild": "^0.28.1",
    "jsdom": "^27.0.1",
    "typescript": "^5.8.2",
    "vitest": "^3.2.7"
  }
}
